{
  "name": "@qified/mono",
  "version": "0.13.1",
  "private": true,
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "description": "Qified Mono Repo",
  "scripts": {
    "test": "pnpm -r test",
    "test:ci": "pnpm -r test:ci",
    "test:services:start": "docker compose up -d",
    "test:services:stop": "docker compose down",
    "website:build": "docula build",
    "website:dev": "docula dev",
    "version:sync": "tsx scripts/version-sync.ts",
    "pack:packages": "mkdir -p packed && pnpm --filter \"./packages/**\" -r pack --pack-destination \"$PWD/packed\"",
    "build": "pnpm --filter qified build && pnpm --filter '!qified' -r build",
    "clean": "pnpm -r clean"
  },
  "keywords": [],
  "author": "Jared Wray <me@jaredwray.com>",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.10",
    "docula": "^2.2.0",
    "rimraf": "^6.1.3",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
