{
  "name": "@qified/mono",
  "version": "0.13.1",
  "private": true,
  "packageManager": "pnpm@11.26.0+sha512.fc0e2bf890b9f983611f1ab68c0637bce914390653699f83c1a78b005ed25f2c81e77920c8fd8eee2ecf0b58b28cdcb00a84d97f69bcf7c56b2f344710238664",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "description": "Qified Mono Repo",
  "scripts": {
    "test": "pnpm -r test",
    "test:ci": "pnpm -r test:ci",
    "test:services:start": "docker compose up -d",
    "test:services:stop": "docker compose down",
    "website:build": "docula build",
    "website:dev": "docula dev",
    "version:sync": "tsx scripts/version-sync.ts",
    "pack:packages": "mkdir -p packed && pnpm --filter \"./packages/**\" -r pack --pack-destination \"$PWD/packed\"",
    "build": "pnpm --filter qified build && pnpm --filter '!qified' -r build",
    "clean": "pnpm -r clean"
  },
  "keywords": [],
  "author": "Jared Wray <me@jaredwray.com>",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/node": "^24.13.4",
    "@vitest/coverage-v8": "^5.0.0",
    "docula": "^3.0.0",
    "rimraf": "^6.1.3",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
